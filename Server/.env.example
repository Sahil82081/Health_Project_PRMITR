# Server Port (assigned by hosting platform like Render/Railway/Heroku or defaults to 8000)
PORT=8000

# Allowed CORS Origins (comma-separated for multiple origins)
# Example: http://localhost:5173,https://your-frontend.vercel.app
DOMAINS=http://localhost:5173

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Python ML Microservice URL (FastAPI)
# For local development: http://127.0.0.1:5000
# For production deployment: https://your-ml-api.onrender.com
ML_API_URL=http://127.0.0.1:5000
